# 🏷️ apiVersion = "v1" is the stable core API group.
apiVersion: v1

# 🏷️ kind = Secret stores sensitive data (API keys, passwords, tokens).
kind: Secret

# 📦 metadata — identifies and describes this secret.
metadata:
  # 📛 name = used by deployments to reference this secret via secretKeyRef.
  name: samvad-api-secret

  # 🌍 namespace = must match the deployment's namespace.
  namespace: samvad-prod

# 🔒 type: Opaque = generic key-value secret.
type: Opaque

# 📝 stringData — plain-text key-value pairs (K8s auto-encodes).
# Unlike the "data" field (which requires pre-base64-encoded values),
# stringData lets you write secrets in plain text in the YAML file.
#
# 📋 Instructions:
#   1. Copy this file to secret.yaml in the same directory.
#   2. Replace the placeholder value below with your real API key.
#   3. Keep secret.yaml out of git (it's in .gitignore).
#   4. NEVER commit secret.yaml with real values to version control.
stringData:
  # 🔑 VALID_API_KEY = the env var name the Go app reads at startup.
  # Change this to your actual API key after copying to secret.yaml.
  VALID_API_KEY: "your-api-key-here"
