apiVersion: v1
kind: Secret
metadata:
  name: samvad-api-secret
  namespace: samvad-dev
type: Opaque
# stringData takes plain text and K8s automatically base64-encodes it on create.
# Unlike the "data" field (which requires pre-encoded values), stringData lets
# you write secrets in plain text in the YAML file.
#
# Copy this to secret.yaml, fill in real values, and keep secret.yaml out of git.
stringData:
  VALID_API_KEY: "your-api-key-here"
